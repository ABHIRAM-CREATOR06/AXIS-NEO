<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme -->
    <style name="Theme.AXISNeo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        
        <item name="colorError">@color/md_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        
        <item name="android:statusBarColor">@color/md_surface_container_low</item>
        <item name="android:navigationBarColor">@color/md_surface_container_low</item>
        
        <!-- Custom Attributes -->
        <item name="surfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="surfaceContainerLow">@color/md_surface_container_low</item>
        <item name="surfaceContainer">@color/md_surface_container</item>
        <item name="surfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="successColor">@color/md_success</item>
        <item name="successContainerColor">@color/md_success_container</item>
        <item name="warningColor">@color/md_warning</item>
        <item name="warningContainerColor">@color/md_warning_container</item>
    </style>
    
    <!-- Dark Theme -->
    <style name="Theme.AXISNeo.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary_dark</item>
        <item name="colorOnPrimary">@color/md_on_primary_dark</item>
        <item name="colorPrimaryContainer">@color/md_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container_dark</item>
        
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container_dark</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container_dark</item>
        
        <item name="colorTertiary">@color/md_tertiary</item>
        
        <item name="colorError">@color/md_error_dark</item>
        <item name="colorErrorContainer">@color/md_error_container_dark</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container_dark</item>
        
        <item name="android:colorBackground">@color/md_surface_dark</item>
        <item name="colorSurface">@color/md_surface_dark</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant_dark</item>
        <item name="colorOnSurface">@color/md_on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant_dark</item>
        
        <item name="colorOutline">@color/md_outline_dark</item>
        <item name="colorOutlineVariant">@color/md_outline_variant_dark</item>
        
        <item name="android:statusBarColor">@color/md_surface_container_low_dark</item>
        <item name="android:navigationBarColor">@color/md_surface_container_low_dark</item>
        
        <!-- Custom Attributes -->
        <item name="surfaceContainerLowest">@color/md_surface_container_lowest_dark</item>
        <item name="surfaceContainerLow">@color/md_surface_container_low_dark</item>
        <item name="surfaceContainer">@color/md_surface_container_dark</item>
        <item name="surfaceContainerHigh">@color/md_surface_container_high_dark</item>
        <item name="successColor">@color/md_success_dark</item>
        <item name="successContainerColor">@color/md_success_container_dark</item>
        <item name="warningColor">@color/md_warning_dark</item>
        <item name="warningContainerColor">@color/md_warning_container_dark</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextAppearance.AXISNeo.GoogleSans.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <style name="TextAppearance.AXISNeo.GoogleSans" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
    </style>
    
    <style name="TextAppearance.AXISNeo.RobotoMono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
    </style>
    
    <!-- Widget Styles -->
    <style name="Widget.AXISNeo.Button.Scan" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
    </style>
    
    <style name="Widget.AXISNeo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_primary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
    </style>
    
    <style name="Widget.AXISNeo.Tab" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/md_primary</item>
        <item name="tabTextColor">@color/md_on_surface_variant</item>
        <item name="tabSelectedTextColor">@color/md_primary</item>
    </style>
    
    <style name="Widget.AXISNeo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">1dp</item>
    </style>
    
    <style name="Widget.AXISNeo.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/md_surface_container_low</item>
    </style>
    
    <!-- Chip Styles -->
    <style name="Widget.AXISNeo.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="chipStrokeColor">@color/md_outline_variant</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
    
    <style name="Widget.AXISNeo.Chip.Score" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
    </style>
    
    <style name="Widget.AXISNeo.Chip.WCAG" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/md_primary_container</item>
        <item name="android:textColor">@color/md_on_primary_container</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
    </style>
    
    <!-- Badge -->
    <style name="Widget.AXISNeo.Badge" parent="">
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">16dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>
</resources>